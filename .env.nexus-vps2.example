# ── EvoNexus VPS 2 — Configuração standalone ─────────────────────────────────
# Copiar para .env.nexus e preencher com os valores reais

# ── Nexus ──────────────────────────────────────────────────────────────────
EVONEXUS_SECRET_KEY=          # python3 -c "import secrets; print(secrets.token_hex(32))"
EVONEXUS_PORT=8080
DASHBOARD_API_TOKEN=          # python3 -c "import secrets; print(secrets.token_hex(32))"

# ── CRM (VPS 1) ────────────────────────────────────────────────────────────
# Apontar para o domínio público da VPS 1
EVO_CRM_URL=https://adam-crm.servecounterstrike.com
EVO_CRM_ACCOUNT_ID=1
EVO_CRM_API_TOKEN=            # Chatwoot > Perfil > Access Token

# ── Evolution API (VPS 1) ──────────────────────────────────────────────────
EVOLUTION_API_URL=https://seu-dominio-evolution.exemplo.com
EVOLUTION_API_KEY=            # chave configurada na Evolution API

# ── LLM / AI ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=            # sk-ant-... (deixar vazio para usar OpenAI)

OPENAI_API_KEY=               # sk-proj-...
OPENROUTER_API_KEY=           # sk-or-v1-...

CLAUDE_CODE_USE_OPENAI=1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
